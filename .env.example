# Copy to .env (Git-ignored) and fill in what your machine needs.
# A variable already set in the environment always wins over this file.

# Absolute path to a PHP 8.1 binary, used by `npm run lint:php`.
# Local by Flywheel ships one per site under its lightning-services directory.
PHP81_BIN=

# WordPress.org SVN credentials, used by `npm run deploy`.
# Leave WPORG_PASSWORD empty for an interactive deploy: svn prompts once and
# caches the credential itself. Set it only for unattended runs.
WPORG_USERNAME=
WPORG_PASSWORD=
WPORG_SLUG=wc-custom-installments
