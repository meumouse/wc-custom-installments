{
	"name": "wc-custom-installments",
	"private": true,
	"version": "1.0.0",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"lint:php": "node scripts/lint-php.mjs",
		"build": "node scripts/build.mjs",
		"build:fast": "node scripts/build.mjs --skip-app --skip-composer --skip-translations --no-install",
		"build:app": "npm run build --prefix app",
		"dev": "npm run dev --prefix app",
		"release": "node scripts/build.mjs",
		"deploy": "node scripts/deploy-svn.mjs",
		"deploy:commit": "node scripts/deploy-svn.mjs --commit",
		"docs:hooks": "node scripts/generate-hook-docs.mjs",
		"docs:check": "node scripts/generate-hook-docs.mjs --check && node scripts/generate-feature-docs.mjs --check",
		"docs:features": "node scripts/generate-feature-docs.mjs",
		"docs": "npm run docs:hooks && npm run docs:features"
	},
	"devDependencies": {
		"archiver": "^7.0.1"
	}
}
